<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Excel Product Mapper</title>
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <style>
    *{box-sizing:border-box}
    body{
      margin:0;
      min-height:100vh;
      display:grid;
      place-items:center;
      font-family:"Segoe UI",Arial,sans-serif;
      background:linear-gradient(145deg,#07111f,#0c1e31);
      color:#f5f9fd;
    }
    .app{
      width:min(520px,calc(100% - 32px));
      padding:34px;
      border:1px solid #27435e;
      border-radius:22px;
      background:#0e2033;
      box-shadow:0 24px 70px rgba(0,0,0,.35);
    }
    h1{
      margin:0 0 28px;
      text-align:center;
      font-size:28px;
      font-weight:750;
    }
    .stack{display:grid;gap:14px}
    input[type=file]{display:none}
    .file-btn,.download-btn{
      width:100%;
      min-height:58px;
      display:flex;
      align-items:center;
      justify-content:center;
      border-radius:14px;
      border:1px solid #31516f;
      font-size:15px;
      font-weight:700;
      cursor:pointer;
      transition:.18s ease;
      user-select:none;
    }
    .file-btn{
      background:#132a42;
      color:#eaf5ff;
    }
    .file-btn:hover{background:#183650;transform:translateY(-1px)}
    .file-btn.ready{
      border-color:#2dd4bf;
      background:#11343a;
    }
    .download-btn{
      border:0;
      background:linear-gradient(90deg,#2dd4bf,#38bdf8);
      color:#04222b;
    }
    .download-btn:hover:not(:disabled){filter:brightness(1.06);transform:translateY(-1px)}
    .download-btn:disabled{opacity:.38;cursor:not-allowed}
    .note{margin-top:4px;text-align:center;font-size:13px;color:#9fb3c8}
  </style>
</head>
<body>
  <main class="app">
    <h1>Dada Group</h1>
    <div class="stack">
      <label class="file-btn" id="priceLabel" for="priceFile">Upload Price File</label>
      <input id="priceFile" type="file" accept=".xlsx,.xls,.xlsm,.xlsb" />

      <label class="file-btn" id="exportLabel" for="exportFile">Upload Export File</label>
      <input id="exportFile" type="file" accept=".xlsx,.xls,.xlsm,.xlsb" />

      <button class="download-btn" id="downloadBtn" disabled>Download File</button>
      <div class="note">Note: Upload the downloaded file to UPDATE PRODUCT.</div>
    </div>
  </main>

<script>
const state={price:null,exp:null,output:null,outputName:'Update_Product_Ready.xlsx'};
const $=id=>document.getElementById(id);
const str=v=>v==null?'':String(v).trim();

function normExact(v){
  let s=str(v).normalize('NFKC').toUpperCase().trim();
  if(/^\d+\.0+$/.test(s)) s=s.replace(/\.0+$/,'');
  return s;
}
function normLoose(v){return normExact(v).replace(/[\s\-_/\\.,،]+/g,'');}
function readAsArrayBuffer(file){
  return new Promise((resolve,reject)=>{
    const r=new FileReader();
    r.onload=()=>resolve(r.result);
    r.onerror=reject;
    r.readAsArrayBuffer(file);
  });
}
async function loadWorkbook(file){
  const ab=await readAsArrayBuffer(file);
  return XLSX.read(ab,{type:'array',cellDates:false,cellNF:true,cellStyles:true});
}
function toRows(ws){return XLSX.utils.sheet_to_json(ws,{header:1,raw:false,defval:'',blankrows:true});}
function firstRows(wb){return toRows(wb.Sheets[wb.SheetNames[0]]);}

function addMap(map,key,value,row,loose=false){
  if(!key||!value)return;
  const k=loose?normLoose(key):normExact(key);
  if(!k)return;
  const old=map.get(k);
  if(!old)map.set(k,{value,row,ambiguous:false});
  else if(normExact(old.value)!==normExact(value))old.ambiguous=true;
}
function buildExportMap(rows){
  const exact=new Map(),loose=new Map();
  for(let r=0;r<rows.length;r++){
    const result=str(rows[r]?.[0]);   // Export A
    const sku=str(rows[r]?.[9]);      // Export J
    if(!sku||!result)continue;
    addMap(exact,sku,result,r+1,false);
    addMap(loose,sku,result,r+1,true);
  }
  return {exact,loose};
}
function findExportValue(sku,maps){
  let h=maps.exact.get(normExact(sku));
  if(h&&!h.ambiguous)return h;
  h=maps.loose.get(normLoose(sku));
  if(h&&!h.ambiguous)return h;
  return null;
}
function makeOutputWorkbook(rows){
  const aoa=[
    ['ID','STOCK','SKU','Price','Sale Price','','','',''],
    ['X','Update  STOCK',' Update  SKU',' Update Price',' Update Sale Price',' Update Name in English',' Update Name in Arabic','Update  Short Description in English','Update  Short Description in Arabic']
  ];
  for(const x of rows) aoa.push([x.a,x.b,x.c,x.d,'','','','','']);
  const ws=XLSX.utils.aoa_to_sheet(aoa);
  ws['!cols']=[{wch:20},{wch:16},{wch:24},{wch:16},{wch:16},{wch:24},{wch:24},{wch:30},{wch:30}];
  const wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb,ws,'Sheet1');
  return wb;
}

async function prepareOutput(){
  $('downloadBtn').disabled=true;
  state.output=null;
  if(!state.price||!state.exp)return;

  try{
    const src=firstRows(state.price);
    const exp=firstRows(state.exp);
    const maps=buildExportMap(exp);
    const out=[];

    // Source starts from row 2. Row 1 is the header.
    for(let r=1;r<src.length;r++){
      const row=src[r]||[];
      const C=str(row[2]);
      const D=str(row[3]);
      const H=str(row[7]);
      const L=str(row[11]);
      const lookupSku=C||D;

      if(!C&&!D&&!H&&!L)continue;
      if(!lookupSku)continue;

      // If SKU is not found in Export column J, the row is excluded.
      const hit=findExportValue(lookupSku,maps);
      if(!hit)continue;

      out.push({
        a:hit.value, // Export A -> output A
        b:L,         // Source L -> output B
        c:lookupSku, // Source C, or D if C is empty -> output C
        d:H          // Source H -> output D
      });
    }

    state.output=makeOutputWorkbook(out);
    const sourceName=$('priceFile').files[0]?.name||'Price_File.xlsx';
    const base=sourceName.replace(/\.(xlsx|xls|xlsm|xlsb)$/i,'');
    state.outputName=base+'_Ready.xlsx';
    $('downloadBtn').disabled=false;
  }catch(e){
    console.error(e);
    alert('Could not process the files. Please make sure both files are valid Excel files.');
  }
}

$('priceFile').addEventListener('change',async()=>{
  const file=$('priceFile').files[0];
  if(!file)return;
  try{
    state.price=await loadWorkbook(file);
    $('priceLabel').textContent='Price File Selected';
    $('priceLabel').classList.add('ready');
    await prepareOutput();
  }catch(e){
    state.price=null;
    $('priceLabel').textContent='Upload Price File';
    $('priceLabel').classList.remove('ready');
    alert('Could not read the Price File.');
  }
});

$('exportFile').addEventListener('change',async()=>{
  const file=$('exportFile').files[0];
  if(!file)return;
  try{
    state.exp=await loadWorkbook(file);
    $('exportLabel').textContent='Export File Selected';
    $('exportLabel').classList.add('ready');
    await prepareOutput();
  }catch(e){
    state.exp=null;
    $('exportLabel').textContent='Upload Export File';
    $('exportLabel').classList.remove('ready');
    alert('Could not read the Export File.');
  }
});

$('downloadBtn').addEventListener('click',()=>{
  if(state.output)XLSX.writeFile(state.output,state.outputName,{bookType:'xlsx'});
});
</script>
</body>
</html>
